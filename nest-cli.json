{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": ".",
  "compilerOptions": {
    "webpack": false,
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.app.json"
  },
  "monorepo": true,
  "root": ".",

  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json",
        "assets": [
          {
            "include": "../../../libs/grpc/src/proto/**/*",
            "outDir": "dist/apps/auth",
            "watchAssets": true
          }
        ]
      }
    },
    "notification": {
      "type": "application",
      "root": "apps/notification",
      "entryFile": "main",
      "sourceRoot": "apps/notification/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification/tsconfig.app.json",
        "assets": [
          {
            "include": "../../../libs/grpc/src/proto/**/*",
            "outDir": "dist/apps/notification",
            "watchAssets": true
          }
        ]
      }
    },
    "sayho-bot": {
      "type": "application",
      "root": "apps/sayho-bot",
      "entryFile": "main",
      "sourceRoot": "apps/sayho-bot/src",
      "compilerOptions": {
        "tsConfigPath": "apps/sayho-bot/tsconfig.app.json",
        "assets": [
          {
            "include": "../../../libs/grpc/src/proto/**/*",
            "outDir": "dist/sayho-bot",
            "watchAssets": true
          }
        ]
      }
    },
    "core": {
      "type": "library",
      "root": "libs/core",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "grpc": {
      "type": "library",
      "root": "libs/grpc",
      "sourceRoot": "libs/grpc/src",
      "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "libs/grpc/tsconfig.json"
      }
    },
    "mikro": {
      "type": "library",
      "root": "libs/mikro",
      "sourceRoot": "libs/mikro/src",
      "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "libs/mikro/tsconfig.json"
      }
    },
    "kafka": {
      "type": "library",
      "root": "libs/kafka",
      "sourceRoot": "libs/kafka/src",
      "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "libs/kafka/tsconfig.lib.json"
      }
    },
    "cache": {
      "type": "library",
      "root": "libs/cache",
      "sourceRoot": "libs/cache/src",
      "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "libs/cache/tsconfig.lib.json"
      }
    },
    "auth-lib": {
      "type": "library",
      "root": "libs/auth",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "libs/auth/tsconfig.lib.json"
      }
    }
  }
}
{
  "name": "elivagar",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "proto:generate": "find ./libs/core/src/proto -name '*.proto' | xargs protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./libs/core/src/proto/generated --proto_path=./libs/core/src/proto",
    "build:sayho-bot": "pnpm proto:generate && nest build sayho-bot",
    "start:sayho-bot": "pnpm proto:generate && TZ=utc dotenvx run -f apps/sayho-bot/.env -- nest start sayho-bot --watch",
    "start:notification": "pnpm proto:generate && TZ=utc dotenvx run -f apps/notification/.env -- nest start notification --watch",
    "start:auth": "pnpm proto:generate && TZ=utc dotenvx run -f apps/auth/.env -- nest start auth --watch",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/elivagar/test/jest-e2e.json",
    "prepare": "ts-patch install"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.5",
    "@grpc/grpc-js": "^1.13.2",
    "@grpc/proto-loader": "^0.7.13",
    "@grpc/reflection": "^1.0.4",
    "@mikro-orm/core": "^6.4.11",
    "@mikro-orm/mariadb": "^6.4.11",
    "@mikro-orm/nestjs": "^6.1.1",
    "@nestia/core": "^5.0.0",
    "@nestia/e2e": "^0.8.3",
    "@nestia/fetcher": "^5.0.0",
    "@nestia/sdk": "^5.0.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "change-case": "^4.1.2",
    "helmet": "^8.1.0",
    "nest-winston": "^1.10.2",
    "nestjs-cls": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typia": "^8.0.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.39.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@nestia/benchmark": "^0.4.3",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/swagger": "^11.0.7",
    "@nestjs/testing": "^11.0.12",
    "@types/express": "^5.0.1",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "22.13.13",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.16.2 ",
    "eslint-plugin-prettier": "^5.2.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "jest": "29.7.0",
    "mikro-orm": "^6.4.11",
    "nestia": "^7.0.0",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "supertest": "7.1.0",
    "ts-jest": "29.3.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "ts-proto": "^2.7.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.8.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/core(|/.*)$": "<rootDir>/libs/core/src/$1"
    }
  }
}
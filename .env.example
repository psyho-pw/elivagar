# =============================================================================
# COMMON CONFIGURATION
# =============================================================================

NODE_ENV="development"

# Shared Database Configuration
DB_HOST="localhost"
DB_USERNAME="elivagar"
DB_PASSWORD="your_password"
DB_DATABASE="elivagar"
DB_PORT="5432"

# Shared Redis Configuration
REDIS_HOST="localhost"
REDIS_PASSWORD="your_redis_password"

# Shared Kafka Configuration
KAFKA_BROKERS="localhost:9092"
KAFKA_SSL="false"

# Shared JWT Configuration
JWT_SECRET="your_jwt_secret"
JWT_REFRESH_SECRET="your_jwt_refresh_secret"
JWT_EXPIRE="600"
JWT_REFRESH_EXPIRE="31536000"
JWT_ALGORITHM="HS256"
CLIENT_URI="http://localhost:3000"

# =============================================================================
# AUTH SERVICE CONFIGURATION
# =============================================================================

AUTH_SERVICE_NAME="auth"
AUTH_PORT="4000"
AUTH_GRPC_PORT="5000"
AUTH_JWT_ISSUER="http://localhost:4000"
AUTH_REDIS_PORT="6000"

# =============================================================================
# NOTIFICATION SERVICE CONFIGURATION
# =============================================================================

NOTIFICATION_SERVICE_NAME="notification"
NOTIFICATION_PORT="4100"
NOTIFICATION_GRPC_PORT="5001"
NOTIFICATION_JWT_ISSUER="http://localhost:4100"
NOTIFICATION_REDIS_PORT="6379"

# =============================================================================
# SAYHO-BOT SERVICE CONFIGURATION
# =============================================================================

SAYHO_BOT_SERVICE_NAME="sayho-bot"
SAYHO_BOT_PORT="4200"
SAYHO_BOT_GRPC_PORT="8000"
SAYHO_BOT_JWT_ISSUER="http://localhost:4200"
SAYHO_BOT_REDIS_PORT="6000"
